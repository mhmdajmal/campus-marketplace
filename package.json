    "@expo/vector-icons": "^15.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
